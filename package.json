{
    "name": "gama-hyper-physics",
    "version": "4.0.0",
    "description": "GAMA AI-Agent Game Engine (Stateful Game Runtime, 4 Game Archetypes, Headless SVG Visual Snapshots, One-Click HTML5 Exporter, Auto-Juice, Headless Auto-Playtester, Zero-GC Physics & 14-Tool MCP Server)",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "directories": {
        "test": "tests"
    },
    "type": "module",
    "bin": {
        "gama-mcp": "./dist/mcp/server.js"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "tsx tests/run_all.ts",
        "start:mcp": "tsx src/mcp/server.ts",
        "mcp": "tsx src/mcp/server.ts",
        "sim": "tsx src/cli.ts",
        "sim:2d": "tsx src/cli.ts --dim 2d --bodies 50 --steps 300",
        "sim:3d": "tsx src/cli.ts --dim 3d --bodies 40 --steps 300",
        "sim:4d": "tsx src/cli.ts --dim 4d --bodies 25 --steps 200",
        "playtest": "tsx src/cli.ts --playtest",
        "snapshot": "tsx src/cli.ts --snapshot",
        "export:demo": "tsx src/cli.ts --export-demo",
        "benchmark": "tsx src/cli.ts --dim 2d --bodies 100 --steps 300"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ahmadshady747-create/gama-hyper-physics.git"
    },
    "keywords": [
        "ai-game-engine",
        "game-engine",
        "mcp-game-dev",
        "physics-engine",
        "headless-playtest",
        "svg-snapshot",
        "html5-game-exporter",
        "auto-juice",
        "typescript"
    ],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ahmadshady747-create/gama-hyper-physics/issues"
    },
    "homepage": "https://github.com/ahmadshady747-create/gama-hyper-physics#readme",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@webgpu/types": "^0.1.72",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "tsx": "^4.23.12"
    }
}
